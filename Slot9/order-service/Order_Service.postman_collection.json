{
  "info": {
    "name": "MSS301 - Order Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "order_base_url",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "01 - Create Order - Success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{order_base_url}}/api/order",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 1000,\n  \"quantity\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response body is correct message\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"Order Placed Successfully\");",
              "});",
              "pm.test(\"Content-Type is text/plain\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create Order - Large Quantity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{order_base_url}}/api/order",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skuCode\": \"pixel_8\",\n  \"price\": 899.99,\n  \"quantity\": 5\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response body is correct message\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"Order Placed Successfully\");",
              "});"
            ]
          }
        }
      ]
    },
    {
