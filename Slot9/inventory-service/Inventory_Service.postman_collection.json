{
  "info": {
    "name": "MSS301 - Inventory Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "inventory_base_url",
      "value": "http://localhost:8082"
    }
  ],
  "item": [
    {
      "name": "01 - Check Stock - In Stock",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{inventory_base_url}}/api/inventory?skuCode=iphone_15&quantity=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"In stock returns true\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"true\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Check Stock - Insufficient Quantity",
      "request": {
